# Copy to .env and fill in. .env is gitignored; never commit a real key.
#
#   cp .env.example .env
#   $EDITOR .env
#   depfix init

# --- LLM ---------------------------------------------------------------------
# gemini | ollama | bedrock
LLM_PROVIDER=gemini
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=3

# Local inference (LLM_PROVIDER=ollama). Code never leaves the machine.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT=120

# AWS Bedrock (LLM_PROVIDER=bedrock)
BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_REGION=us-east-1
BEDROCK_ACCESS_KEY=
BEDROCK_SECRET_KEY=
BEDROCK_PROFILE=

# Escalation: run a cheap primary, pay for a strong model only on the changes
# the primary could not produce a committable edit for. Empty disables it.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=

# --- Storage -----------------------------------------------------------------
# Local dev defaults to a SQLite file. Use Postgres for shared/concurrent runs:
#   DATABASE_URL=postgresql+psycopg://depfix:depfix@localhost:5432/depfix
DATABASE_URL=sqlite:///depfix.db
REDIS_URL=

# --- Feeds -------------------------------------------------------------------
PROVIDERS_FILE=providers.yaml
# Skip re-polling a feed whose last *successful* poll is younger than this.
# Failed polls are never cached. 0 = always poll. `depfix watch --refresh` bypasses it.
FEED_POLL_TTL_SECONDS=3600
NPM_REGISTRY_URL=https://registry.npmjs.org
PYPI_REGISTRY_URL=https://pypi.org
# Unauthenticated GitHub is 60 req/hr; two feeds exhaust that in a day of cron.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
SPEC_CACHE_DIR=./.depfix-cache/specs

# --- GitHub App (needed for `scan --repo`, `plan`, `apply`) ------------------
GITHUB_APP_ID=
# Inline PEM wins over the path if both are set.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
CLONE_DIR=
CLONE_MAX_REPO_MB=500

# --- Scanning ----------------------------------------------------------------
# Hard-capped at 15000; a larger value is rejected at start-up.
SCAN_MAX_FILES=15000
SCAN_MAX_FILE_BYTES=2000000
SCAN_MIN_RECALL=0.85
SCAN_PREPARE_PACKAGE_MANAGER=true
SCAN_LLM_JUDGE_ENABLED=false
# deterministic | hybrid | agent
SCAN_STRATEGY=hybrid
SCAN_AGENT_MAX_STEPS=25
SCAN_AGENT_JUDGE_CAP=20

# --- Verification ------------------------------------------------------------
VERIFY_ENABLED=true
VERIFY_INSTALL_TIMEOUT=300
VERIFY_TEST_TIMEOUT=300
VERIFY_IGNORE_SCRIPTS=true
VERIFY_TYPECHECK_ENABLED=true
# Behaviour snapshots for CommonJS repos with no test suite. Costs extra LLM
# calls and only applies to single-file changes, so opt-in.
VERIFY_CHARACTERIZE_ENABLED=false
CHARACTERIZATION_ALWAYS_RUN=true
CHARACTERIZATION_STRICT=false
SMOKE_ALWAYS_RUN=true
SMOKE_STRICT=false
SMOKE_WINDOW_SECONDS=8.0
PLAN_IMPACT_CHECK_ENABLED=true
RETRY_MAX_ROUNDS=2

# --- Confidence policy -------------------------------------------------------
# Refuse to open a PR below this tier: high | medium | low | none
APPLY_MIN_CONFIDENCE=low
# Open as a draft below this tier. Default means only test-confirmed fixes
# arrive ready-for-review.
DRAFT_BELOW_CONFIDENCE=high
CODEMODS_ENABLED=true
LOCKFILE_REGENERATE=true

# --- Fleet orchestrator ------------------------------------------------------
REPO_CONFIG_FILENAME=.depfix.yml
PIPELINE_REQUIRE_CONFIG_FILE=true
PIPELINE_MAX_OPEN_PRS=5
PIPELINE_MAX_ATTEMPTS=3
PIPELINE_RETRY_COOLDOWN_HOURS=6
PIPELINE_MAX_CHANGES_PER_REPO=3
PIPELINE_MAX_COST_USD_PER_RUN=
PIPELINE_MAX_DURATION_MINUTES=

# --- Observability -----------------------------------------------------------
LOG_LEVEL=INFO
# text for a terminal, json for a log aggregator
LOG_FORMAT=text
ENVIRONMENT=development
SENTRY_DSN=
